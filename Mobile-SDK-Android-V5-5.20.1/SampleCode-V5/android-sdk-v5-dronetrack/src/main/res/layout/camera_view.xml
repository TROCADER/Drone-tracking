<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">

    <dji.v5.ux.core.widget.fpv.FPVWidget
        android:id="@+id/widget_primary_fpv"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <dji.sampleV5.aircraft.DetectionOverlay
        android:id="@+id/detection_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gimbal_dpad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="50dp">

        <Button
            android:id="@+id/gim_pitchup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P+"
            app:layout_constraintStart_toEndOf="@+id/gim_yawleft"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/gim_pitchdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P-"
            app:layout_constraintStart_toEndOf="@+id/gim_yawleft"
            app:layout_constraintTop_toBottomOf="@+id/gim_yawleft" />

        <Button
            android:id="@+id/gim_yawleft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Y-"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gim_pitchup" />

        <Button
            android:id="@+id/gim_yawright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Y+"
            app:layout_constraintStart_toEndOf="@+id/gim_pitchdown"
            app:layout_constraintTop_toBottomOf="@+id/gim_pitchup" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/pid_tune_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="50dp"
        android:layout_marginTop="50dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/pid_kp_tune"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pid_kp_text"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="Kp: #" />

            <Button
                android:id="@+id/pid_kp_decr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-" />

            <Button
                android:id="@+id/pid_kp_incr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/pid_ki_tune"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pid_ki_text"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="Ki: #" />

            <Button
                android:id="@+id/pid_ki_decr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-" />

            <Button
                android:id="@+id/pid_ki_incr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/pid_kd_tune"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pid_kd_text"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="Kd: #" />

            <Button
                android:id="@+id/pid_kd_decr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-" />

            <Button
                android:id="@+id/pid_kd_incr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bot_detection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Switch
            android:id="@+id/enable_det"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detection"
            android:textAppearance="@style/SwitchTextAppearance" />

        <Switch
            android:id="@+id/enable_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tracking"
            android:textAppearance="@style/SwitchTextAppearance" />

        <TextView
            android:id="@+id/det_time_text"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detection not running" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2">

            <TextView
                android:id="@+id/conf_slider_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confidence: #%"
                android:textAppearance="@style/SwitchTextAppearance"
                app:layout_constraintBottom_toTopOf="@+id/iou_slider_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/iou_slider_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IoU: #%"
                android:textAppearance="@style/SwitchTextAppearance"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/conf_slider_text" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/label_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="end"
                app:constraint_referenced_ids="conf_slider_text,iou_slider_text" />

            <SeekBar
                android:id="@+id/conf_slider"
                style="@style/Widget.AppCompat.SeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/conf_slider_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/label_barrier"
                app:layout_constraintTop_toTopOf="@+id/conf_slider_text" />

            <SeekBar
                android:id="@+id/iou_slider"
                style="@style/Widget.AppCompat.SeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/iou_slider_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/label_barrier"
                app:layout_constraintTop_toTopOf="@+id/iou_slider_text" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</RelativeLayout>
